/*
 * Nextflow Configuration - SPIM Pipeline
 * IMP Vienna - Andrés Gordo & Guilherme Ventura
 * 
 * Resource allocation and SLURM settings.
 * Scientific parameters are in config.json.
 */

manifest {
    name            = 'SPIM 4D Processing Pipeline'
    author          = 'Andrés Gordo & Guilherme Ventura'
    homePage        = 'https://github.com/andresgordoortiz/spim_preprocessing'
    description     = 'Lightsheet microscopy preprocessing, segmentation, and 4D merging'
    mainScript      = 'spim_pipeline.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

// Global defaults

// Global defaults
params {
    max_memory = 256.GB
    max_cpus = 32
    max_time = 48.h
    max_retries = 1
    container = 'library://andresgordoortiz/spim_imp/python_packages_spim:sha256.6ef173bb45b113a36deae4315200cd8f311de2d7108b4b73e8f17a12cffe7559'
    fiji_container = 'docker://fiji/fiji:20220415'
}

// SLURM executor

// SLURM executor
executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
    pollInterval = '30 sec'
    queueStatInterval = '5 min'
    exitReadTimeout = '30 min'
}

// Process resources

// Process resources
process {
    executor = 'slurm'
    errorStrategy = 'terminate'
    maxRetries = params.max_retries
    container = params.container
    cpus = 4
    memory = 32.GB
    time = 2.h

    // ROI Cropping
    withName: 'CROP_WITH_ROI' {
        cpus = 2
        memory = 16.GB
        time = 30.m
        queue = 'c'
        clusterOptions = '--qos=c_short'

        publishDir = [
            [
                path: { "${params.output_dir}/00_cropped" },
                mode: 'copy',
                pattern: '*_cropped.tif'
            ],
            [
                path: { "${params.output_dir}/logs/cropping" },
                mode: 'copy',
                pattern: '*.log'
            ]
        ]
    }

    withName: 'EXTRACT_METADATA' {
        cpus = 2
        memory = 8.GB
        time = 30.m
        queue = 'c'
        clusterOptions = '--qos=c_short'

        publishDir = [
            path: { "${params.output_dir}/metadata" },
            mode: 'copy',
            pattern: '*.json'
        ]
    }

    withName: 'PREPROCESS_DECONVOLVE' {
        cpus = 8
        memory = 128.GB
        time = 2.h
        queue = 'g'
        clusterOptions = '--gres=gpu:1'

        publishDir = [
            [
                path: { "${params.output_dir}/01_preprocessed" },
                mode: 'copy',
                pattern: '*_processed.tif'
            ],
            [
                path: { "${params.output_dir}/logs/preprocessing" },
                mode: 'copy',
                pattern: '*.log'
            ]
        ]
    }

    withName: 'CELLPOSE_SEGMENT' {
        cpus = 4
        memory = 64.GB
        time = 2.h
        queue = 'g'
        clusterOptions = '--gres=gpu:1 --exclude=clip-g1-[0-6]'

        publishDir = [
            [
                path: { "${params.output_dir}/02_segmented" },
                mode: 'copy',
                pattern: '*_segmented.tif'
            ],
            [
                path: { "${params.output_dir}/logs/segmentation" },
                mode: 'copy',
                pattern: '*.log'
            ]
        ]
    }

    withName: 'MERGE_TO_HYPERSTACK' {
        cpus = 8
        memory = 128.GB
        time = 1.h
        queue = 'c'
        clusterOptions = '--qos=c_medium'

        publishDir = [
            path: { "${params.output_dir}/03_hyperstack" },
            mode: 'copy'
        ]
    }

    withName: 'GENERATE_QC_REPORT' {
        cpus = 2
        memory = 16.GB
        time = 30.m
        queue = 'c'
        clusterOptions = '--qos=c_short'

        publishDir = [
            path: { "${params.output_dir}/reports" },
            mode: 'copy'
        ]
    }
}

// ============================================================================
// Singularity Configuration
// ============================================================================

apptainer {
    enabled = true
    autoMounts = true
    ociAutoPull = true
    pullTimeout = '60 min'
    runOptions = '--nv'
}

// Reports
report {
    enabled = true
    overwrite = true
}

timeline {
    enabled = true
    overwrite = true
}

trace {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

dag {
    enabled = true
    overwrite = true
}

// Execution profiles
profiles {
    standard {
        process {
            executor = 'slurm'
            queue = 'g'
        }
    }

    highres {
        process {
            withName: 'CROP_WITH_ROI' {
                memory = 32.GB
                time = 1.h
            }

            withName: 'PREPROCESS_DECONVOLVE' {
                cpus = 16
                memory = 128.GB
                time = 4.h
            }

            withName: 'CELLPOSE_SEGMENT' {
                cpus = 8
                memory = 128.GB
                time = 4.h
            }

            withName: 'MERGE_TO_HYPERSTACK' {
                memory = 256.GB
                time = 2.h
            }
        }
    }

    local {
        process {
            executor = 'local'
            cpus = 4
            memory = 16.GB
            time = 1.h
        }
    }

    test {
        process {
            executor = 'local'
            cpus = 2
            memory = 8.GB
            time = 30.m

            withName: 'CROP_WITH_ROI' {
                cpus = 2
                memory = 8.GB
            }

            withName: 'PREPROCESS_DECONVOLVE' {
                cpus = 4
                memory = 16.GB
            }

            withName: 'CELLPOSE_SEGMENT' {
                cpus = 2
                memory = 16.GB
            }
        }
    }
}

// Cleanup and environment
cleanup = true

workDir = "$params.output_dir/work"

env {
    PYTHONUNBUFFERED = '1'
    JAVA_TOOL_OPTIONS = '-Xmx4g'
}