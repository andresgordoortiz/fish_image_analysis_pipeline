/*
 * Nextflow Configuration - SPIM Pipeline
 * IMP Vienna - Andrés Gordo & Guilherme Ventura
 *
 * Resource allocation and SLURM settings.
 * Scientific parameters are in config.json.
 */
manifest {
    name            = 'SPIM 4D Processing Pipeline'
    author          = 'Andrés Gordo & Guilherme Ventura'
    homePage        = 'https://github.com/andresgordoortiz/spim_preprocessing'
    description     = 'Lightsheet microscopy preprocessing, segmentation, and 4D merging'
    mainScript      = 'spim_pipeline.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
// Global defaults
params {
    max_memory = 256.GB
    max_cpus = 32
    max_time = 48.h
    max_retries = 3  // Changed from 1 to 3
    container = 'library://andresgordoortiz/spim_imp/python_packages_spim:sha256.6ef173bb45b113a36deae4315200cd8f311de2d7108b4b73e8f17a12cffe7559'
    fiji_container = 'docker://fiji/fiji:20220415'
}
// SLURM executor
executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
    pollInterval = '30 sec'
    queueStatInterval = '5 min'
    exitReadTimeout = '30 min'
}
// Process resources (publishDir is defined in spim_pipeline.nf)
process {
    executor = 'slurm'
    errorStrategy = 'retry'  // Changed from 'terminate' to 'retry'
    maxRetries = params.max_retries
    container = params.container
    cpus = 4
    memory = 32.GB
    time = 2.h

    withName: 'CROP_WITH_ROI' {
        cpus = 2
        memory = 16.GB
        time = 30.m
        queue = 'c'
        clusterOptions = '--qos=c_short'
    }

    withName: 'SPLIT_INPUT_FILE' {
        // Loads a (potentially very large, e.g. 10GB+) CZI / hyperstack TIFF
        // into memory and writes one TIFF per timepoint. Memory needs to
        // comfortably hold the full uncompressed array.
        cpus = 4
        memory = { 64.GB * task.attempt }
        time = { 2.h * task.attempt }
        queue = 'c'
        clusterOptions = '--qos=c_medium'
    }

    withName: 'EXTRACT_METADATA' {
        cpus = 2
        memory = 8.GB
        time = 30.m
        queue = 'c'
        clusterOptions = '--qos=c_short'
    }

    withName: 'RESLICE_ISOTROPIC' {
        // Lightweight per-timepoint Z resampling (scipy.ndimage.zoom).
        // Memory grows with output size: input_Z * (z_pixel/xy_pixel) * Y * X * 2 bytes.
        cpus = 2
        memory = { 16.GB * task.attempt }
        time = { 30.m * task.attempt }
        queue = 'c'
        clusterOptions = '--qos=c_short'
    }

    withName: 'PREPROCESS_DECONVOLVE' {
        cpus = 4
        memory = { 32.GB * task.attempt }
        time = { 45.m * task.attempt }
        queue = 'g'
        clusterOptions = '--gres=gpu:1'
    }

    withName: 'CELLPOSE_SEGMENT' {
        cpus = 4
        memory = 30.GB
        time = 1.h
        queue = 'g'
        clusterOptions = '--gres=gpu:1 --exclude=clip-g1-[0-6]'
    }

    withName: 'MERGE_TO_HYPERSTACK' {
        cpus = 8
        memory = 128.GB
        time = 1.h
        queue = 'c'
        clusterOptions = '--qos=c_medium'
    }

    withName: 'GENERATE_QC_REPORT|DOWNSCALE_SEGMENTATION' {
        cpus = 2
        memory = 8.GB
        time = 30.m
        queue = 'c'
        clusterOptions = '--qos=c_short'
    }

    withName: 'BENCHMARK' {
        cpus = 4
        memory = 32.GB
        time = 1.h
        queue = 'c'
        clusterOptions = '--qos=c_short'
    }

    withName: 'PREP_ULTRACK' {
        cpus = 4
        memory = 70.GB
        time = 1.h + 30.m
        queue = 'g'
        clusterOptions = '--gres=gpu:1'
    }

    withName: 'ULTRACK_SEGMENT' {
        cpus = 8
        memory = 64.GB
        time = { 2.h * task.attempt }
        queue = 'c'
        clusterOptions = '--qos=c_medium'
    }

    withName: 'ULTRACK_LINK' {
        cpus = 8
        memory = 64.GB
        time = { 1.h * task.attempt }
        queue = 'c'
        clusterOptions = '--qos=c_medium'
    }

    withName: 'ULTRACK_SOLVE' {
        cpus = 22
        memory = 132.GB
        time = { 3.h * task.attempt }
        queue = 'c'
        clusterOptions = '--qos=c_medium --nodelist=clip-c2-71'
    }

    withName: 'ULTRACK_EXPORT' {
        cpus = 4
        memory = 32.GB
        time = 1.h
        queue = 'c'
        clusterOptions = '--qos=c_medium'
    }

    withName: 'DEBUG_PREPROCESS_NUCLEI' {
        cpus = 4
        memory = { 64.GB * task.attempt }
        time = { 1.h * task.attempt }
        queue = 'g'
        clusterOptions = '--gres=gpu:1 --exclude=clip-g1-[0-6]'
    }

    withName: 'DEBUG_PREPROCESS_REPORT' {
        cpus = 2
        memory = 8.GB
        time = 30.m
        queue = 'c'
        clusterOptions = '--qos=c_short'
    }
}
// Apptainer/Singularity
apptainer {
    enabled = true
    autoMounts = true
    ociAutoPull = true
    pullTimeout = '60 min'
    // --no-mount hostfs disables the system 'mount hostfs = yes' setting which
    // scans /proc/mounts on the node and tries to bind-mount everything,
    // including transient SLURM per-job tmpfs mounts like
    // /scratch-cbe/jobtmp/<host>/<jobid>. On heavily multi-tenant GPU nodes
    // these mounts can race with sibling jobs ending, producing
    // "mount source X doesn't exist" container creation failures.
    //
    // Disabling hostfs also drops the implicit /users (home filesystem)
    // bind, so we re-add it explicitly. Nextflow runs apptainer with
    // --no-home, which is fine for HOME isolation, but tools like Cellpose
    // still try to write caches under ~/.cellpose etc., so /users must be
    // visible to resolve those paths.
    runOptions = '--nv --no-mount hostfs -B /users -B /groups -B /scratch-cbe'
}
// Reports
report {
    enabled = true
    overwrite = true
}
timeline {
    enabled = true
    overwrite = true
}
trace {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}
dag {
    enabled = true
    overwrite = true
}
// Execution profiles
profiles {
    standard {
        process {
            executor = 'slurm'
            queue = 'g'
        }
    }
    highres {
        process {
            withName: 'PREPROCESS_DECONVOLVE' {
                cpus = 16
                memory = 128.GB
                time = 4.h
            }
            withName: 'CELLPOSE_SEGMENT' {
                cpus = 8
                memory = 128.GB
                time = 4.h
            }
            withName: 'MERGE_TO_HYPERSTACK' {
                memory = 256.GB
                time = 2.h
            }
            withName: 'PREP_ULTRACK' {
                memory = 128.GB
                time = 3.h
            }
            withName: 'ULTRACK_TRACK' {
                memory = 128.GB
                time = 6.h
            }
        }
    }
    local {
        process {
            executor = 'local'
            cpus = 4
            memory = 16.GB
            time = 1.h
        }
    }
    test {
        process {
            executor = 'local'
            cpus = 2
            memory = 8.GB
            time = 30.m
        }
    }
}
// Cleanup — must be false when resume is enabled, otherwise work dirs
// are deleted on success and subsequent -resume runs have nothing to cache from.
cleanup = false
env {
    PYTHONUNBUFFERED = '1'
    JAVA_TOOL_OPTIONS = '-Xmx4g'
}