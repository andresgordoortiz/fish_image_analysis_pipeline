# --- Python Specific ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
build/
dist/
*.egg-info/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
# Prevents tracking of large notebook autosave files
.virtual_documents/

# --- Fiji / ImageJ ---
# Ignore Fiji/ImageJ specific update and temp files
/Fiji.app/
/ImageJ/
*.lck
# If you run macros that generate temp log files
*.ijm.log
# Typical ImageJ temporary measurement files
Statistics.csv

# --- Custom Data Folder ---
# This ignores the "data" folder specifically
/data/
# Use this if you want to ignore any folder named "non-trackable"
**/non-trackable/

# --- Nextflow ---
# Runtime artifacts (binary cache, run history, log files). These are
# regenerated on every run and can be very large (.nextflow/ alone is
# ~140 MB after a few runs). Add new ones as nextflow versions add them.
.nextflow/
.nextflow.log
.nextflow.log.*
trace-*.txt
# User-supplied pre-made 4D hyperstacks (only relevant for the
# --preprocessed/--segmented developer bypass; never committed)
4D_hyperstack_*.tif
4D_hyperstack_*.h5
4D_hyperstack_*.xml
# Pipeline work dir (per-run task workdirs; same reason as .nextflow/)
work/

# --- System & IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/