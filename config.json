{
  "pipeline": {
    "name": "SPIM 4D Image Processing Pipeline",
    "version": "1.0.0",
    "author": "Andrés Gordo & Guilherme Ventura",
    "institute": "IMP Vienna"
  },

  "input": {
    "directory": "./subset/",
    "channel": 2
  },

  "output": {
    "directory": "./subset_results/",
    "format": "tiff",
    "correct_y": false,
    "skip_merge": true
  },

  "seqera_tower": {
    "enabled": true,
    "access_token": "eyJ0aWQiOiAxMzM2Nn0uZWRlMTAxYmIzZGE4ZDNjMzJjM2M1MmZkZThhNjBhZGI2M2EyNjE4Mg=="
  },

  "roi_cropping": {
    "enabled": false,
    "roi_path": "./medaka_spim_crop.roi"
  },

  "voxel_size": {
    "auto_detect": false,
    "x_um": 0.347,
    "y_um": 0.347,
    "z_um": 2.0
  },

  "preprocessing": {
    "enabled": true,
    "_comment_isotropic_reslice": "When enabled=false, lightly resample Z so voxels become isotropic (XY pixel size). Lets raw + segmented + tracks share the same shape for overlay. Defaults to true when preprocessing is skipped, false when full preprocessing runs (because full preprocessing already reslices).",
    "isotropic_reslice": true,
    "psf_path": "/groups/pinheiro/user/guilherme.ventura/for_analysis/SPIM/things_from_Andres/scripts_from_Andres/image_processing_script/psf_models/PSF_small_low-res.tif",
    "image_scaling": 0.33,
    "save_intermediates": true,
    "deconvolution": {
      "niter": 3,
      "niterz": 3,
      "padding": 64
    },
    "normalization": {
      "min_v": 0,
      "max_v": 65535,
      "percentile_low": 10.0,
      "percentile_high": 99.9
    },
    "background_subtraction": {
      "resolution_px0": 10,
      "resolution_pz0": 10,
      "noise_lvl": 2
    },
    "postprocessing": {
      "sigma": 1.2
    },
    "correction_flags": {
      "no_clahe": false,
      "no_z_correction": false,
      "no_shading": false
    },

    "debug_preprocessing": {
      "enabled": true,
      "save_masks": false,
      "_comment": "Cellpose params are inherited from the 'segmentation' section. Override here only if needed."
    }
  },

  "segmentation": {
    "enabled": false,
    "model": "/groups/pinheiro/user/guilherme.ventura/for_analysis/SPIM/things_from_Thomas/cellpose/models/cpsam_Gui_tracking_20250801",
    "diameter": 30,
    "flow_threshold": 0.8,
    "cellprob_threshold": 0.0,
    "use_gpu": true,
    "do_3d": true,
    "anisotropy": null,
    "stitch_threshold": null,
    "min_size": 15,
    "save_tif": true,
    "save_flows": false,
    "save_npy": false,
    "downscale_labels": 1.0
  },

  "benchmark": {
    "enabled": true
  },

  "tracking": {
    "enabled": false,
    "ultrack_container": "/groups/pinheiro/user/andres.gordo/processed_data/M45/ultrack_cuda12_gurobi.sif",
    "ultrack_config_toml": "/groups/pinheiro/user/andres.gordo/processed_data/M45/medaka_071125/ultrack_config.toml",
    "prep": {
      "fg_sigma": 5.0,
      "raw_sigma": 1.0,
      "boundary_width": 1,
      "min_area": 10
    }
  },

  "system": {
    "container_image": "library://andresgordoortiz/spim_imp/python_packages_spim:sha256.6ef173bb45b113a36deae4315200cd8f311de2d7108b4b73e8f17a12cffe7559",
    "fiji_container_image": "docker://fiji/fiji:20220415",
    "profile": "standard",
    "resume": true
  }
}
